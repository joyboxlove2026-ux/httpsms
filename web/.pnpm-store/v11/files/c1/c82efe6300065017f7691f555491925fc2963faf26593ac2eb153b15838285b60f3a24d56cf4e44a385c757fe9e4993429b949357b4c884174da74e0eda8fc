    const customUrl = toValue(options.url);
    let canonicalUrl;
    if (customUrl) {
      canonicalUrl = customUrl;
    } else {
      let url = resolveUrl(route.path || "/").value || route.path;
      if (canonicalLowercase) {
        url = url.toLowerCase();
      }
      const filteredQuery = Object.fromEntries(
        Object.entries(route.query).filter(([key]) => canonicalQueryWhitelist.includes(key)).sort(([a], [b]) => a.localeCompare(b))
