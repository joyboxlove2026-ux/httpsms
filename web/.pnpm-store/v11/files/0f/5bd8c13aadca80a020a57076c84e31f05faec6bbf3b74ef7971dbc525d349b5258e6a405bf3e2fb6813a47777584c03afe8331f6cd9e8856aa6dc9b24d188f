{
  "name": "nuxtseo-shared",
  "type": "module",
  "version": "5.3.10",
  "description": "Shared utilities for Nuxt SEO modules.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://nuxtseo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-seo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-seo/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./kit": {
      "types": "./dist/kit.d.mts",
      "default": "./dist/kit.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "default": "./dist/devtools.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.mts",
      "default": "./dist/i18n.mjs"
    },
    "./pro": {
      "types": "./dist/pro.d.mts",
      "default": "./dist/pro.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./const": {
      "types": "./dist/const.d.mts",
      "default": "./dist/const.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@nuxt/schema": "^3.16.0 || ^4.0.0 || ^5.0.0",
    "nuxt": "^3.16.0 || ^4.0.0 || ^5.0.0",
    "nuxt-site-config": "^3.2.0 || ^4.0.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt-site-config": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@nuxt/devtools-kit": "4.0.0-alpha.7",
    "@nuxt/kit": "^4.5.1",
    "birpc": "^4.0.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "nypm": "^0.6.9",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "radix3": "^1.1.2",
    "sirv": "^3.0.2",
    "std-env": "^4.2.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "h3": "^1.15.11",
    "nitropack": "^2.13.4",
    "nuxt": "^4.5.1",
    "nuxt-site-config": "^4.1.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build prepare",
    "stub": "nuxt-module-build build --stub",
    "test": "vitest",
    "test:run": "vitest run && pnpm test:nuxt5",
    "test:nuxt5": "pnpm --dir test/fixtures/nitro-compat-nuxt5 install --frozen-lockfile && pnpm --dir test/fixtures/nitro-compat-nuxt5 test",
    "test:attw": "attw --pack --profile esm-only",
    "typecheck": "nuxt typecheck ."
  }
}