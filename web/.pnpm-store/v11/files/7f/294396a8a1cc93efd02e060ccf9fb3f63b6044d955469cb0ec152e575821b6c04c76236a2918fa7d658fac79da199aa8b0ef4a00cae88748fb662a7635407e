    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.1",
    "@unocss/nuxt": "^66.7.5",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@unocss/runtime": "^66.7.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-harlanzw": "^0.17.0",
    "execa": "^10.0.0",
