{
  "name": "@nuxtjs/sitemap",
  "type": "module",
  "version": "8.3.3",
  "description": "Powerfully flexible XML Sitemaps that integrate seamlessly, for Nuxt.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://github.com/nuxt-modules/sitemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/sitemap.git"
  },
  "bugs": {
    "url": "https://github.com/nuxt-modules/sitemap/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./content": "./dist/content.mjs",
    "./utils": "./dist/utils.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ],
      "utils": [
        "./dist/utils.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "nuxt-site-config": "^4.1.5",
    "nuxtseo-shared": "^5.3.10",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "radix3": "^1.1.2",
    "ufo": "^1.6.4",
    "ultrahtml": "^1.7.0",
    "sitemapd": "^0.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuxt/content": "^3.15.2",
    "@nuxt/devtools-kit": "4.0.0-alpha.9",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.1.3",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^13.0.2",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-harlanzw": "^0.17.1",
    "happy-dom": "^20.11.1",
    "nuxt": "^4.5.1",
    "nuxt-i18n-micro": "^3.26.0",
    "nuxtseo-layer-devtools": "^5.3.10",
    "std-env": "^4.2.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "zod": "^4.4.3",
    "@nuxtjs/sitemap": "8.3.3"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "client:build": "node -e \"const { cpSync } = require('fs'); const { sep } = require('path'); cpSync('devtools','dist/devtools',{recursive:true,filter:src=>!src.split(sep).some(p=>['.data','.nuxt','node_modules'].includes(p))})\"",
    "build": "pnpm --filter sitemapd build && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && npm run client:build",
    "dev": "nuxt dev playground",
    "prepare:fixtures": "nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/i18n && nuxt prepare test/fixtures/i18n-micro",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && pnpm run client:build",
    "release": "pnpm build && bumpp -x \"npx changelogen --output=CHANGELOG.md\"",
    "release:sitemapd": "pnpm --filter sitemapd release",
    "test": "pnpm --filter sitemapd test && vitest run && pnpm run test:attw && pnpm run test:nuxt5",
    "test:unit": "vitest --project=unit",
    "test:nuxt5": "pnpm pack --out test/fixtures/nuxt5/module.tgz && pnpm install --dir test/fixtures/nuxt5 --no-frozen-lockfile --update-checksums && pnpm --dir test/fixtures/nuxt5 test",
    "test:attw": "attw --pack && pnpm --filter sitemapd test:attw",
    "typecheck": "pnpm --filter sitemapd typecheck && nuxt typecheck"
  }
}