# Sandbox defaults for the Base44 compose stack (docker-compose.base44.yml).
#
# This file is loaded FIRST, before the platform-managed /run/base44/app.env,
# so anything the user supplies through the Base44 dashboard overrides the
# values below. Nothing in here is a real credential: it only exists so the
# stack boots without any external service.
#
# Values that are not secrets (service URLs, local database credentials, the
# API port) live here too, so the compose file stays readable.

# --- API -------------------------------------------------------------------
ENV=local
APP_NAME=httpSMS
APP_PORT=8000
APP_HOST=0.0.0.0
USE_HTTP_LOGGER=true

# No feature entitlement limits for self hosted/sandbox deployments.
ENTITLEMENT_ENABLED=false

# The event queue is the API calling itself (see EVENTS_QUEUE_ENDPOINT).
EVENTS_QUEUE_TYPE=emulator
EVENTS_QUEUE_NAME=events-local
EVENTS_QUEUE_ENDPOINT=http://127.0.0.1:8000/v1/events
# Local system user, created by the `seed` service in docker-compose.base44.yml.
EVENTS_QUEUE_USER_API_KEY=system-user-api-key
EVENTS_QUEUE_USER_ID=system-user-id

# Firebase Admin credentials (single line service account JSON).
# Left empty on purpose: base44/api-entrypoint.sh generates a throwaway
# service account so the API can boot. Push notifications need a real key.
FIREBASE_CREDENTIALS=
GCP_PROJECT_ID=httpsms-local

# Local infrastructure.
DATABASE_URL=postgresql://dbusername:dbpassword@postgres:5432/httpsms
DATABASE_URL_DEDICATED=postgresql://dbusername:dbpassword@postgres:5432/httpsms
REDIS_URL=redis://redis:6379

# Email (only used to notify users their phone went offline).
SMTP_FROM_NAME=httpSMS
SMTP_FROM_EMAIL=httpsms@local.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=2525

# MMS attachments fall back to in-memory storage when this is empty.
GCS_BUCKET_NAME=

# Optional realtime updates for the web UI.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Web -------------------------------------------------------------------
APP_ENV=production
APP_GITHUB_URL=https://github.com/NdoleStudio/httpsms
APP_DOCUMENTATION_URL=https://docs.httpsms.com
APP_DOWNLOAD_URL=https://github.com/NdoleStudio/httpsms/releases/latest/download/HttpSms.apk
CHECKOUT_URL=
ENTERPRISE_CHECKOUT_URL=

# Firebase web SDK config used by the login page. Empty means the login page
# renders but Firebase Auth is disabled until real values are supplied.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Cloudflare Turnstile captcha for the message search page (optional).
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
